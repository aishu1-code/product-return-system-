{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/a3-shopping-platform run build",
  "outputDirectory": "a3-shopping-platform/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
